# ============================================================
# 通用 .gitignore —— 适配多语言、多 IDE 的零基础学生作品集
# 生成时间：2026-10-13
# ============================================================

# ----------- 操作系统垃圾文件 -----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.Trash-*

# ----------- 常见编辑器/IDE -----------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains 系列 (PyCharm / IntelliJ / WebStorm 等)
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / MyEclipse
.project
.classpath
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

