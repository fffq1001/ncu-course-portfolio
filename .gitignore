target/
**/*.rs.bk
Cargo.lock.bak

# 数据库
*.db
*.sqlite
*.sqlite3

# ----------- 日志与临时文件 -----------
*.log
logs/
*.tmp
*.swp
*.bak
*.swo

# ----------- 大文件 / 依赖 / 构建产物 -----------
*.zip
*.tar.gz
*.7z
*.rar
*.gz
node_modules/
vendor/

# ----------- 敏感信息（绝对不要上传）-----------
# 警告：请把真实的 .env / 密钥 永远加入此列表
.env
.env.local
.env.*.local
*.pem
*.key
secrets.yml
secrets.yaml
config.ini

# ----------- 工具与其它 -----------
.codebuddy/
.DS_Store
*.sw?
desktop.ini
